DATABASE_URL="postgresql://postgres:postgres@localhost:55432/xacrebook?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV=development

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123

# Optional locally (cover uploads fall back to local disk). Required in
# production — local disk doesn't survive a redeploy or a Render free-tier
# spin-down, so without these, uploaded cover images disappear.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
